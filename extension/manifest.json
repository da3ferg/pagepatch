{
  "manifest_version": 3,
  "name": "PagePatch",
  "description": "Select a section of a page, describe a change, preview it, and turn it into a draft pull request.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": { "default_title": "PagePatch: select a section" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "identity"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
